# Live model calls are opt-in so a public demo cannot silently spend quota.
ALLOW_LIVE_GEMINI=false
GEMINI_MODEL=gemini-3.7-flash

# Required in production. Use the same value of at least 32 bytes across every
# Cloud Run instance so reviewed provenance survives routing and restarts.
# COMPILE_TOKEN_SECRET=

# Option A: Gemini Developer API
# GEMINI_API_KEY=

# Option B: Vertex AI on Google Cloud (uses Application Default Credentials)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

PORT=8080
